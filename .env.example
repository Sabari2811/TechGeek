TRADING_MODE=PAPER
INDSTOCKS_ACCESS_TOKEN=replace_with_your_local_token
INDSTOCKS_BASE_URL=https://api.indstocks.com
NIFTY_UNDERLYING_ID=40000001
RISK_CAPITAL=2000000
RISK_PER_TRADE=0.005
MAX_DAILY_LOSS=20000
MAX_TRADES=3
MAX_LOTS_PER_TRADE=1
MIN_NET_EV=10
MAX_SPREAD_PCT=0.04
MAX_QUOTE_SOURCE_DIFF_PCT=0.005
STALE_SECONDS=3
STRIKE_COUNT=5  # provider fetch window; strategy evaluates exactly 16 selected contracts
POLL_SECONDS=2
RISK_FREE_RATE=0.06
DIVIDEND_YIELD=0.01

# Optional: private GitHub repository for PAPER research batches only
GH_RESEARCH_REPOSITORY=your-github-username/your-private-research-repo
GH_RESEARCH_TOKEN=replace_with_fine_grained_token_contents_write
GH_RESEARCH_SYNC_INTERVAL_SECONDS=300
